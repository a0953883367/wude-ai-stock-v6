# Optional: FinMind enriches the ranking with institutional flow data.
FINMIND_TOKEN=
SEC_USER_AGENT=WudeAIStock/6.32 github.com/a0953883367/wude-ai-stock-v6
# Optional private coverage audit for the Tiingo free individual plan.
TIINGO_API_KEY=

# Required only when Telegram delivery is wanted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Real-time large-buy alerts require a separate bot and a separate chat.
# They intentionally never fall back to the scheduled-report bot or chat.
TELEGRAM_LIVE_BOT_TOKEN=
# Optional after the owner sends /start to the dedicated bot.
TELEGRAM_LIVE_CHAT_ID=
TELEGRAM_LIVE_BATCH_SECONDS=10

# Fubon Neo local Windows runner.
# NEVER commit real values. Prefer API Key login for unattended automation.
FUBON_ID=
FUBON_API_KEY=
FUBON_PASSWORD=
FUBON_CERT_PATH=
FUBON_CERT_PASSWORD=
FUBON_AUTO_GIT=0

# Owner-only cloud live service. FUBON_CERT_BASE64 is the p12 certificate
# encoded as base64 by the cloud secret store; never place the value here.
FUBON_CERT_BASE64=
LIVE_ALLOWED_ORIGINS=https://a0953883367.github.io
LIVE_ACCESS_TOKEN=
TRADE_STATE_PATH=/data/trading_state.json
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
TRADING_INTERVAL_SECONDS=60
LIVE_ORDER_TIMEOUT_SECONDS=180
# 真單確認值只能存於雲端祕密；紙上交易驗證完成前請保持空白。
LIVE_TRADING_CONFIRMATION=
LIVE_TRADING_CONFIRMATION_INPUT=
LIVE_TRUSTED_AUTH_HEADER=
LIVE_PUBLIC_READ=0
LIVE_QUOTE_TTL_SECONDS=2
LIVE_OPTION_TTL_SECONDS=60
LIVE_MAX_REQUESTS_PER_MINUTE=120
LARGE_BUY_MONITOR_ENABLED=1
LARGE_BUY_STATE_PATH=/data/large_buy_alerts.json
# Public, credential-free health URLs used only by the independent system guard.
PRIMARY_APP_URL=https://a0953883367.github.io/wude-ai-stock-v6/
LIVE_HEALTH_URL=https://wude-ai-stock-v6-production.up.railway.app/health
WEB_PUSH_STATE_DIR=/data
WEB_PUSH_SUBJECT=mailto:a0953883367@gmail.com
HOST=0.0.0.0
PORT=8080

# Railway application-level owner authentication. Generate a long random
# value and deliver it once through a URL fragment; never commit the value.
# Example private link suffix: #live_token=<the secret value>

# Optional authoritative US market data. Keep secrets out of the repository.
# SIP covers consolidated US equities; OPRA is enabled only when subscribed.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_STOCK_FEED=sip
ALPACA_OPTION_FEED=

TOP_N=10
HISTORY_DAYS=45
REQUEST_TIMEOUT=25
